# ---------- 模型权重：体积大、各自有许可，不入库 ----------
# 放置方式见 models/README.md
models/*
!models/README.md

# ---------- 第三方 3D 资产：许可归原作者，不入库 ----------
# 自备 .vrm 放入 3d/，见 docs/ASSETS.md
3d/*.vrm
3d/*.glb
3d/*.gltf
3d/*.fbx

# ---------- 测试视频：含真人面部，不入库 ----------
test_videos/*.mp4
test_videos/*.mov
test_videos/*_preview.jpg

# ---------- 运行产物 ----------
runtime_log.csv
boot_analysis.csv
run_*.csv
run_*.log
run_console.log
calibration/history/
# 标定向导产出的结果
calibration/sim/
# 现场标定结果：每台机器 / 每个后端都不一样，生成后不要提交
calibration/*/active.json
random_audit/out/
tests/_tmp_audit/
tests/tmp*/

# 本地归档目录（具体名字不进仓库，见 .git/info/exclude）

