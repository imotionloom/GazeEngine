# 统一按文本处理，仓库内一律 LF，检出时按平台转换
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.proto text eol=lf
*.hpp   text eol=lf

# Windows 脚本保留 CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.obj   binary
*.onnx  binary
*.task  binary
*.vrm   binary
*.mp4   binary
